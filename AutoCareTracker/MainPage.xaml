<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AutoCareTracker.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AutoCareTracker.ViewModels"
    BackgroundColor="#F5F6FA"
    Shell.NavBarIsVisible="False">

    <Grid>
        <!--  СЛОЙ 1: Основной контент (Шапка + Поиск + Список)  -->
        <!--  Добавили третью строку (Auto) специально для поиска  -->
        <Grid RowDefinitions="Auto, Auto, *">

            <!--  1. Фоновый градиент (теперь чуть выше для динамики)  -->
            <BoxView
                Grid.Row="0"
                HeightRequest="250"
                VerticalOptions="Start">
                <BoxView.Background>
                    <LinearGradientBrush EndPoint="1,1">
                        <GradientStop Offset="0.1" Color="#4572ED" />
                        <GradientStop Offset="1.0" Color="#2AB27B" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>

            <!--  ОСНОВНОЙ КОНТЕНТ ШАПКИ  -->
            <VerticalStackLayout
                Grid.Row="0"
                Padding="20,45,20,0"
                Spacing="15">

                <!--  Верхняя панель действий  -->
                <Grid ColumnDefinitions="Auto, *, Auto">

                    <!--  Кнопка "Назад" в стиле круглого бейджа  -->
                    <Frame
                        Grid.Column="0"
                        Padding="0"
                        BackgroundColor="#33FFFFFF"
                        BorderColor="Transparent"
                        CornerRadius="20"
                        HasShadow="False"
                        HeightRequest="40"
                        WidthRequest="40">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToGarageCommand}" />
                        </Frame.GestureRecognizers>
                        <Label
                            FontSize="20"
                            HorizontalOptions="Center"
                            Text="←"
                            TextColor="White"
                            TranslationY="-1"
                            VerticalOptions="Center" />
                    </Frame>

                    <!--  Название авто по центру  -->
                    <VerticalStackLayout
                        Grid.Column="1"
                        HorizontalOptions="Center"
                        Spacing="2"
                        VerticalOptions="Center">
                        <Label
                            FontAttributes="Bold"
                            FontSize="20"
                            HorizontalOptions="Center"
                            Text="{Binding CurrentVehicleHeader}"
                            TextColor="White" />
                        <Label
                            CharacterSpacing="2"
                            FontAttributes="Bold"
                            FontSize="11"
                            HorizontalOptions="Center"
                            Text="{Binding CurrentVehiclePlate}"
                            TextColor="#E0E0E0" />
                    </VerticalStackLayout>

                    <!--  Кнопка экспорта в таком же стиле  -->
                    <Frame
                        Grid.Column="2"
                        Padding="0"
                        BackgroundColor="#33FFFFFF"
                        BorderColor="Transparent"
                        CornerRadius="20"
                        HasShadow="False"
                        HeightRequest="40"
                        WidthRequest="40">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ExportToCsvCommand}" />
                        </Frame.GestureRecognizers>
                        <Label
                            FontSize="20"
                            HorizontalOptions="Center"
                            Text="⇪"
                            TextColor="White"
                            TranslationY="-2"
                            VerticalOptions="Center" />
                    </Frame>
                </Grid>

                <!--  Карточка "Статистика" с мягкой тенью и более чистым дизайном  -->
                <Frame
                    Margin="5,5,5,0"
                    Padding="20"
                    BackgroundColor="White"
                    BorderColor="Transparent"
                    CornerRadius="20"
                    HasShadow="True">
                    <Frame.Shadow>
                        <Shadow
                            Brush="Black"
                            Opacity="0.1"
                            Radius="15"
                            Offset="0,5" />
                    </Frame.Shadow>
                    <Grid ColumnDefinitions="*, 1, *" ColumnSpacing="15">
                        <!--  Блок Трат  -->
                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                            <Label
                                CharacterSpacing="1"
                                FontAttributes="Bold"
                                FontSize="10"
                                Text="ОБЩИЕ ТРАТЫ"
                                TextColor="#95A5A6" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="22"
                                Text="{Binding TotalCost, StringFormat='{0:N0} ₽'}"
                                TextColor="#2C3E50" />
                        </VerticalStackLayout>

                        <!--  Разделитель  -->
                        <BoxView
                            Grid.Column="1"
                            BackgroundColor="#F0F3F5"
                            VerticalOptions="Fill"
                            WidthRequest="1" />

                        <!--  Блок Масла  -->
                        <VerticalStackLayout Grid.Column="2" Spacing="5">
                            <Label
                                CharacterSpacing="1"
                                FontAttributes="Bold"
                                FontSize="10"
                                HorizontalOptions="End"
                                Text="ДО ЗАМЕНЫ"
                                TextColor="#95A5A6" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="12"
                                HorizontalOptions="End"
                                MaxLines="2"
                                Text="{Binding OilStatus}"
                                TextColor="#4572ED"
                                VerticalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </Frame>
            </VerticalStackLayout>

            <!--  2. Поиск с легким эффектом парения  -->
            <Frame
                Grid.Row="1"
                Margin="25,5,25,10"
                Padding="5,0"
                BackgroundColor="White"
                BorderColor="Transparent"
                CornerRadius="24"
                HasShadow="True"
                HeightRequest="48">
                <Frame.Shadow>
                    <Shadow
                        Brush="Black"
                        Opacity="0.05"
                        Radius="5"
                        Offset="0,2" />
                </Frame.Shadow>
                <SearchBar
                    BackgroundColor="Transparent"
                    FontSize="14"
                    Placeholder="Найти запись..."
                    Text="{Binding SearchText}" />
            </Frame>

            <!--  3. Список записей (Row 2)  -->
            <CollectionView
                Grid.Row="2"
                Margin="0,5,0,0"
                ItemsSource="{Binding Records}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Margin="0,50,0,0"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                        <Label
                            FontSize="60"
                            HorizontalOptions="Center"
                            Text="🚗" />
                        <Label
                            FontSize="16"
                            HorizontalOptions="Center"
                            Text="Записей не найдено"
                            TextColor="Gray" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem
                                        BackgroundColor="#FF5252"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=DeleteRecordCommand}"
                                        CommandParameter="{Binding .}"
                                        Text="Удалить" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Frame
                                Margin="15,6"
                                Padding="15"
                                BackgroundColor="White"
                                BorderColor="Transparent"
                                CornerRadius="12"
                                HasShadow="False">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=EditRecordCommand}" CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>
                                <Grid ColumnDefinitions="40, *, Auto" ColumnSpacing="15">
                                    <Ellipse
                                        Grid.Column="0"
                                        Fill="#F0F3FF"
                                        HeightRequest="40"
                                        WidthRequest="40" />
                                    <Label
                                        Grid.Column="0"
                                        FontSize="18"
                                        HorizontalOptions="Center"
                                        Text="🛠"
                                        VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="16"
                                            Text="{Binding WorkType}"
                                            TextColor="#2C3E50" />
                                        <Label
                                            FontSize="12"
                                            Text="{Binding Date, StringFormat='{0:dd MMM yyyy}'}"
                                            TextColor="Gray" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout
                                        Grid.Column="2"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center">
                                        <Label
                                            FontAttributes="Bold"
                                            HorizontalOptions="End"
                                            Text="{Binding Cost, StringFormat='{0:N0} ₽'}"
                                            TextColor="#2AB27B" />
                                        <Label
                                            FontSize="11"
                                            HorizontalOptions="End"
                                            Text="{Binding Mileage, StringFormat='{0} км'}"
                                            TextColor="Gray" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Frame>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!--  СЛОЙ 2: Кнопка FAB  -->
        <Button
            Margin="0,0,25,30"
            BackgroundColor="#4572ED"
            Command="{Binding GoToAddPageCommand}"
            CornerRadius="32"
            FontSize="30"
            HeightRequest="65"
            HorizontalOptions="End"
            Text="+"
            TextColor="White"
            VerticalOptions="End"
            WidthRequest="65">
            <Button.Shadow>
                <Shadow
                    Brush="Black"
                    Opacity="0.3"
                    Radius="10"
                    Offset="0,10" />
            </Button.Shadow>
        </Button>

    </Grid>
</ContentPage>
