<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AutoCareTracker.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AutoCareTracker"
    xmlns:views="clr-namespace:AutoCareTracker.Views"
    Title="AutoCareTracker"
    Shell.FlyoutBehavior="Disabled">

    <ShellContent
        Title="Garage"
        ContentTemplate="{DataTemplate views:GaragePage}"
        Route="GaragePage" />
    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

</Shell>
